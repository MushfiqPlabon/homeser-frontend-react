// vercel.json
// This file configures how the HomeSer React frontend is deployed on Vercel.
// It specifies the build process (using @vercel/static-build) and defines routing rules
// to serve the static build output from the 'dist' directory.
{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}