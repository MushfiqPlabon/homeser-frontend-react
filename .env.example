# ======================================
# FRONTEND ENVIRONMENT VARIABLES
# ======================================

# Backend API base URL
# For local development with backend running on port 8000
VITE_API_BASE_URL=http://localhost:8000/api

# For production deployment, update this to your deployed backend URL
# Example: VITE_API_BASE_URL=https://your-backend-domain.vercel.app/api

# ======================================
# OPTIONAL FRONTEND SETTINGS
# ======================================

# App title (optional - defaults to "HomeSer")
# VITE_APP_TITLE=HomeSer

# Enable development features (optional - defaults to false in production)
# VITE_DEV_MODE=true

# Analytics tracking ID (optional)
# VITE_ANALYTICS_ID=your-analytics-id

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=your-sentry-dsn