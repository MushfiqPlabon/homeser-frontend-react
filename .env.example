# ======================================
# FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# ======================================

# Backend API base URL - This will be set in Vercel environment variables
VITE_API_BASE_URL=https://homeser-backend-drf.vercel.app/api

# Pusher credentials
VITE_PUSHER_KEY=your-pusher-key
VITE_PUSHER_CLUSTER=your-pusher-cluster

# App title - displayed in the browser tab and header
VITE_APP_TITLE=HomeSer

# Disable development features in production
VITE_DEV_MODE=false

# ======================================
# OPTIONAL PRODUCTION SETTINGS
# ======================================

# Analytics tracking ID for Google Analytics or similar services
# VITE_ANALYTICS_ID=your-analytics-id

# Sentry DSN for error tracking and monitoring
# VITE_SENTRY_DSN=your-sentry-dsn

# Content Security Policy settings
# VITE_CSP_REPORT_ONLY=true

# Enable or disable service worker caching
# VITE_ENABLE_SERVICE_WORKER=true

# WebSocket connection timeout (in milliseconds)
# VITE_WS_TIMEOUT=30000

# Set cache expiration time for API responses (in milliseconds)
VITE_API_CACHE_TTL=300000